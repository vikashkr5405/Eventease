<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Events</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
    <div class="container mt-4">
        <div class="d-flex justify-content-between mb-4">
            <h2>Manage Events</h2>
            <a href="/admin/events/create" class="btn btn-success btn-sm">+ADD</a>
            <a href="/admin/dashboard" class="btn btn-secondary">Dashboard</a>
        </div>
        <table class="table table-success table-striped table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>City</th>
                    <th>Price</th>
                    <th>Available-seats</th>
                    <th>Edit</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% events.forEach(event => {%>
                    <tr>
                        <td>
                            <%= event.title %>
                        </td>
                        <td>
                            <%= event.city %>
                        </td>
                        <td>
                            <%= event.price %>
                        </td>
                        <td>
                            <%= event.availableSeats %>
                        </td>
                        <td>
                            <a href="/admin/events/edit/<%= event._id %>" class="btn btn-warning btn-sm">Edit</a>
                        </td>
                        <td>
                            <form action="/admin/events/delete/<%= event._id %>" method="post">
                                <button class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                    <%}); %>
            </tbody>
        </table>
    </div>
</body>

</html>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
    integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
    crossorigin="anonymous"></script>