<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <div class="container mt-3">
        <div class="d-flex justify-content-between mb-4">
            <h2>All Bookings</h2>
            <a href="/admin/dashboard" class="btn btn-secondary">Dashboard</a>
        </div>
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Event</th>
                    <th>Quantity</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% bookings.forEach(booking =>{%>
                    <tr>
                        <td>
                            <%= booking.user ? booking.user.name : "User Deleted" %>
                        </td>
                        <td>
                            <%= booking.user ? booking.user.email : "User Deleted" %>
                        </td>
                        <td>
                            <%= booking.event.title %>
                        </td>
                        <td>
                            <%= booking.quantity %>
                        </td>
                        <td>
                            <%= booking.totalAmount %>
                        </td>
                        <td>
                            <%= booking.paymentStatus %>
                        </td>
                        <td>
                            <% if (booking.paymentStatus !== "cancelled") {%>
                                <form action="/admin/bookings/cancel/<%= booking._id %>" method="post">
                                <button class="btn btn-danger btn-sm">Cancel</button>
                                </form>
                            <%} %>
                        </td>
                    </tr>
                <%}) %>
            </tbody>
        </table>
    </div>
</body>
</html>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
    integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
    crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
    integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
    crossorigin="anonymous"></script>