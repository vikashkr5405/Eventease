<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventEase</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body{
            background: linear-gradient(135deg,#4f46e5,#06b6d4);
            min-height:100vh;
            font-family:Arial, Helvetica, sans-serif;
        }

        .navbar{
            background:rgba(255,255,255,.1);
            backdrop-filter:blur(10px);
        }

        .hero{
            height:85vh;
            display:flex;
            justify-content:center;
            align-items:center;
        }

        .hero-card{
            background:white;
            border-radius:20px;
            padding:60px;
            text-align:center;
            box-shadow:0 20px 40px rgba(0,0,0,.2);
            max-width:700px;
        }

        .hero-card h1{
            font-size:60px;
            font-weight:bold;
            color:#4f46e5;
        }

        .hero-card p{
            color:#666;
            font-size:20px;
            margin:20px 0;
        }

        .btn-custom{
            padding:12px 35px;
            font-size:18px;
            border-radius:50px;
            margin:10px;
        }

        footer{
            color:white;
            text-align:center;
            padding:20px;
        }
    </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
    <div class="container">

        <a class="navbar-brand text-white fw-bold fs-3" href="/">
            🎉 EventEase
        </a>

        <div class="ms-auto">

            <a href="/login" class="btn btn-light me-2">
                Login
            </a>

            <a href="/register" class="btn btn-warning me-2">
                Register
            </a>

            <a href="/admin/loginPage" class="btn btn-danger">
                Admin Login
            </a>

        </div>

    </div>
</nav>


<div class="container hero">

    <div class="hero-card">

        <h1>EventEase</h1>

        <p>
            Book your favorite events in just a few clicks.
            Fast, Secure and Easy.
        </p>

        <a href="/register" class="btn btn-primary btn-lg btn-custom">
            Get Started
        </a>


    </div>

</div>

<footer>
    © 2026 EventEase | Made with ❤️ using Node.js, Express & MongoDB
</footer>

</body>
</html>